---
import { getCollection } from "astro:content";
const posts = await getCollection("content");
---

<ul>
  {
    posts
      .filter((x) => x.filePath != "content/index.mdx")
      .map((post) => (
        <li>
          <a href={`/${post.id}/`}>{post.data.title}</a>
        </li>
      ))
  }
</ul>
