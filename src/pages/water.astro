---
import "@/styles/water.css";
import { BaseHead } from "selo-components";

const letters = {
  a: ["atl", "Nahuatl"],
  b: ["biyo", "Somali"],
  c: ["c̣q̇ali", "Georgian"],
  d: ["dŵr", "Welsh"],
  e: ["eau", "French"],
  f: ["faní", "Rohingya"],
  g: ["g̱ántl", "Haida"],
  h: ["húdōr", "Ancient Greek"],
  i: ["imaq", "Inuktitut"],
  j: ["jaʼ", "K'iche'"],
  k: ["kuuyi", "Hopi"],
  l: ["lee", "Afar"],
  m: ["māʔ", "Arabic"],
  n: ["nước", "Vietnamese"],
  o: ["omi", "Yoruba"],
  p: ["pānī", "Hindi"],
  q: ["qla", "Nuxalk"],
  r: ["ruwā", "Hausa"],
  s: ["su", "Turkish"],
  t: ["tubig", "Tagalog"],
  u: ["uisce", "Irish"],
  v: ["vesi", "Finnish"],
  w: ["water", "English"],
  x: ["xi", "Chechen"],
  y: ["yaku", "Quechua"],
  z: ["zanum", "Kavalan"],
};
---

<html lang="en">
  <head>
    <BaseHead
      title="Learn the alphabet!"
      description="A completely normal alphabet for children. Nothing silly going on."
    />
  </head>
  <body>
    <div><h1>Learn the alphabet!</h1></div>
    <article>
      {
        Object.entries(letters).map(([char, [word, lang]]) => (
          <div>
            <h2>{`${char.toUpperCase()}${char}`}</h2>
            <img src="https://clipart-library.com/newhp/glass-of-water-clipart-md.png" />
            <span>is for</span> <b>{word}</b>
            <br />
            <i>{lang}</i>
          </div>
        ))
      }
    </article>
  </body>
</html>
