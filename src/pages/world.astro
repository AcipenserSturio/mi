---
import GanttWorld from "@/components/chart/GanttWorld.svelte";
import { BaseHead } from "selo-components";
import periods from "/world/periods.csv?url&raw";
import tracks from "/world/tracks.csv?url&raw";
import colours from "/world/colours.csv?url&raw";
---

<html lang="en">
  <head>
    <BaseHead title="Chart" description="WIP Chart" />
  </head>
  <body>
    <GanttWorld
      csvText={periods}
      csvTracks={tracks}
      csvColours={colours}
      width={5000}
      height={3000}
      client:only="svelte"
    />
  </body>
</html>
